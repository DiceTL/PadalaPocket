# Documentation only: never place real secrets in this file.
# S-001 runs without service credentials. Future tasks add validated integrations.
# Frontend: only public values may use the VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only; never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
VELO_API_KEY=
# B-001 Gas Station · Testnet key, separate from the general checkout key.
VELO_GAS_API_KEY=
VELO_GAS_BASE_URL=https://www.velo-build.dev
# Placeholder name; choose a provider in B-004 before integrating.
AI_API_KEY=
# Testnet secrets only; B-001 creates the actual protected proof path.
OPERATOR_TOKEN=
OWNER_SECRET=
AGENT_SECRET=
MERCHANT_SECRET=
# B-001 operator CLI initializes these in ignored .env.local; never use VITE_.
PROOF_ENABLED=false
# gas is the historical default; DEC-042 explicitly migrates the B-001 proof to direct.
PROOF_TRANSPORT=gas
PROOF_CHECKOUT_ID=
PROOF_OPERATION_ID=
PROOF_DEVICE_HASH=
PROOF_NONCE=
PROOF_EXPIRES_AT=
PROOF_ENVELOPE_KIND=
PROOF_ENVELOPE_XDR=
PROOF_BASE_URL=
# Optional Vercel deployment-protection automation secret, server/operator only.
VERCEL_AUTOMATION_BYPASS_SECRET=
