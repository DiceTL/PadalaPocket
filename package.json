{
  "name": "padalapocket",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": "26.x"
  },
  "packageManager": "npm@12.2.1",
  "scripts": {
    "dev:web": "npm run dev --workspace @padalapocket/web",
    "dev:api": "npm run dev --workspace @padalapocket/api",
    "test": "npm run test --workspaces",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check": "npm run check:contracts && npm test && npm run build",
    "build": "npm run build --workspaces"
  }
}
